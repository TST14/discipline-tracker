DATABASE_URL=postgresql://user:password@localhost:5432/discipline_tracker

# Set to true during local development to enable /docs and /redoc Swagger UI
DEBUG=true

# Comma-separated list of allowed frontend origins (no trailing slashes)
# Add your Vercel URL here after first deployment, e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# Random secret used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret

# Bcrypt hash of your login password. Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=
